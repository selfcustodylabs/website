{
  "name": "selfcustodylabs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "lint": "eslint src/ --ext .js,.jsx",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,md}\"",
    "check": "node scripts/check-content.mjs --summary",
    "og": "python3 scripts/generate-og-images.py",
    "images": "python3 scripts/optimize-images.py",
    "seo:check": "node scripts/seo-snapshot.mjs --compare scripts/seo-baseline.json",
    "seo:accept": "node scripts/seo-snapshot.mjs --write scripts/seo-baseline.json",
    "verify": "npm run lint && npm run check && python3 scripts/optimize-images.py --check && npm run build && npm run seo:check"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-sitemap": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mdx-js/react": "^3.0.0",
    "@mui/icons-material": "^5.14.16",
    "@mui/material": "^5.14.17",
    "clsx": "^1.2.1",
    "prism-react-renderer": "^2.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "js-yaml": "^4.3.2",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.9",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.19"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
